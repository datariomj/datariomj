{
  "name": "datariomj",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:staging": "ng build --configuration staging",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "lint": "ng lint",
    "lint:styles": "stylelint \"{src,src/app,src/stylings}/**/*.scss\"",
    "prep": "npm run lint -- --fix && npm run lint:styles -- --fix",
    "gen:docs": "compodoc -p tsconfig.app.json src",
    "cy:open": "./node_modules/.bin/cypress run --headed",
    "cy:run": "./node_modules/.bin/cypress run",
    "e2e": "ng e2e",
    "e2e:ci": "ng run datariomj:e2e-ci",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "lighthouse": "cypress run --browser chrome --spec cypress/e2e/lighthouse.cy.ts",
    "generate:changelog": "git-cliff > CHANGELOG.md",
    "changelog:version": "git-cliff --bumped-version",
    "generate:changelog:release": "git-cliff --config cliff.toml > CHANGELOG.md"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.7",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@angular/service-worker": "^22.0.7",
    "@ngxs/devtools-plugin": "^21.0.0",
    "@ngxs/logger-plugin": "^21.0.0",
    "@ngxs/store": "^21.0.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@badeball/cypress-cucumber-preprocessor": "^23.2.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.6",
    "@compodoc/compodoc": "^2.0.0",
    "@cypress-audit/lighthouse": "^1.4.2",
    "@cypress/schematic": "^2.5.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@typescript-eslint/utils": "^8.64.0",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.5.4",
    "cypress": "^15.18.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.36.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^60.3.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "git-cliff": "^2.8.0",
    "jasmine-core": "^6.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.20",
    "stylelint": "^16.24.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-no-unsupported-browser-features": "^8.0.0",
    "stylelint-scss": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": "cypress/e2e/**/*.ts",
    "specPattern": "cypress/e2e/**/*.feature"
  }
}
