{
  "name": "datariomj",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.19.1"
  },
  "scripts": {
    "ng": "ng",
    "start": "npm run generate:deployment-assets && ng serve",
    "build": "npm run generate:deployment-assets && ng build",
    "build:staging": "npm run generate:deployment-assets && ng build --configuration staging",
    "build:prod": "npm run generate:deployment-assets && ng build --configuration production",
    "sentry:sourcemaps": "release=${SENTRY_RELEASE:-$npm_package_version}; sentry-cli sourcemaps inject --release $release ./dist/datariomj/browser && sentry-cli sourcemaps upload --release $release ./dist/datariomj/browser",
    "test": "ng test",
    "lint": "ng lint",
    "lint:styles": "stylelint \"{src,src/app,src/stylings}/**/*.scss\"",
    "prep": "npm run lint -- --fix && npm run lint:styles -- --fix",
    "gen:docs": "compodoc -p tsconfig.app.json src",
    "cy:open": "./node_modules/.bin/cypress run --headed",
    "cy:run": "./node_modules/.bin/cypress run",
    "e2e": "npm run generate:deployment-assets && ng e2e",
    "e2e:ci": "npm run generate:deployment-assets && ng run datariomj:e2e-ci",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "lighthouse": "cypress run --browser chrome --spec cypress/e2e/lighthouse.cy.ts",
    "generate:changelog": "git-cliff > CHANGELOG.md",
    "changelog:version": "git-cliff --bumped-version",
    "generate:changelog:release": "git-cliff --config cliff.toml > CHANGELOG.md",
    "generate:changelog:unreleased": "git-cliff --unreleased --strip header --config cliff.toml",
    "generate:deployment-assets": "node scripts/generate-deployment-assets.mjs",
    "codacy:check": "npm run lint && npm run lint:styles && npm run test:coverage",
    "test:ci": "ng test --no-watch",
    "test:coverage": "npm run test:ci -- --coverage",
    "codecov:upload": "node scripts/codecov-upload.mjs",
    "codecov:run": "npm run test:coverage && npm run codecov:upload"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.0.7",
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "@angular/service-worker": "^22.0.7",
    "@ngxs/devtools-plugin": "^22.0.0",
    "@ngxs/logger-plugin": "^22.0.0",
    "@ngxs/store": "^22.0.0",
    "@sentry/angular": "^10.69.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@badeball/cypress-cucumber-preprocessor": "^23.2.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.6",
    "@compodoc/compodoc": "^2.0.0",
    "@cypress-audit/lighthouse": "^1.4.2",
    "@cypress/schematic": "^2.5.1",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.36.0",
    "@sentry/cli": "^3.6.2",
    "@types/jasmine": "^5.1.15",
    "@types/node": "^24.5.2",
    "@typescript-eslint/eslint-plugin": "^8.44.1",
    "@typescript-eslint/parser": "^8.44.1",
    "@typescript-eslint/utils": "^8.64.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^22.1.0",
    "autoprefixer": "^10.5.4",
    "codecov": "^3.8.3",
    "cypress": "^15.18.1",
    "cypress-axe": "^1.7.0",
    "eslint": "^9.36.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-jsdoc": "^60.3.1",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "git-cliff": "^2.8.0",
    "jasmine-core": "^6.3.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.23",
    "stylelint": "^16.24.0",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-no-unsupported-browser-features": "^8.0.0",
    "stylelint-scss": "^6.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "nanoid": "3.3.17",
    "js-yaml": "4.3.1",
    "ip-address": "10.3.1"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/**/*.ts",
      "!cypress/e2e/**/*.cy.ts"
    ],
    "specPattern": "cypress/e2e/**/*.feature"
  }
}
