# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly declare binary files to prevent line ending issues or corruption
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.mp4 binary
*.mov binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Special Linguist definitions
src/index.html linguist-vendored
documentation/* linguist-documentation
